{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lake-archive",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "archive.lakekim.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lake-archive",
      "database_id": "586de279-7de6-4579-b2f6-e6aa5aca0549",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "SYNC_REPOSITORY": "lakekimhandsome/lake-archive",
    "SYNC_REF": "main"
  }
}
